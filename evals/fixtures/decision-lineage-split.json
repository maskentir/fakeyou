{
  "version": 1,
  "benchmark": "decision-lineage-pairs.json",
  "unit": "topic",
  "rationale": "Pairs reuse claims, and a claim's paraphrases and follow-ups stay inside its engineering topic. Every claim belongs to exactly one topic, every topic to exactly one partition, and a pair belongs to the partition of its two claims. A pair whose claims fall in different partitions is quarantined and scored in neither. Meetings are not the unit: a lineage pair always spans two meetings, so a meeting split would quarantine most pairs.",
  "partitions": {
    "development": "Prompt and threshold iteration, the pilot run, and error analysis.",
    "frozen_evaluation": "Scored once per approved classifier version. Never used to tune prompts, thresholds or labels.",
    "real_world_validation": "Reserved for consented real meeting records labelled by two humans. Empty: no real data exists yet."
  },

from collections.abc import Sequence
from typing import SupportsFloat

class SpeakerEmbeddingExtractorConfig:
    def __init__(
        self, model: str, num_threads: int = 1, debug: bool = False, provider: str = "cpu"
    ) -> None: ...

class OnlineStream:
    def accept_waveform(
        self, sample_rate: SupportsFloat, waveform: Sequence[SupportsFloat]
    ) -> None: ...
    def input_finished(self) -> None: ...

class SpeakerEmbeddingExtractor:
    def __init__(self, config: SpeakerEmbeddingExtractorConfig) -> None: ...
    @property
    def dim(self) -> int: ...
    def create_stream(self) -> OnlineStream: ...
    def compute(self, arg0: OnlineStream, /) -> list[float]: ...

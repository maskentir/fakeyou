# Isi API key setiap peran yang diaktifkan secara eksplisit.
# EMBEDDING_DIM tidak perlu diisi: CLI memakai FAKEYOU_MEMORY__EMBEDDER__DIM untuk Graphiti.
FAKEYOU_IDENTITY__OWNER_ID=local_owner
FAKEYOU_IDENTITY__TWIN_ID=local_twin
FAKEYOU_IDENTITY__TWIN_NAME=Fakeyou Twin
# Voiceprint dimatikan secara default. Aktifkan hanya setelah model dan kalibrasi tersedia.
# FAKEYOU_IDENTITY__VOICEPRINT_ENABLED=false
# FAKEYOU_IDENTITY__VOICEPRINT_MODEL_PATH=
# FAKEYOU_IDENTITY__VOICEPRINT_MODEL_SHA256=c59158379255ad66e161679cca6af8d52d51e389e3224ab7d7a7baae295c2db5
# FAKEYOU_IDENTITY__VOICEPRINT_CALIBRATION_PATH=
# FAKEYOU_IDENTITY__VOICEPRINT_THRESHOLD=0.6
# FAKEYOU_IDENTITY__VOICEPRINT_MIN_MARGIN=0.15
# FAKEYOU_IDENTITY__VOICEPRINT_MIN_SECONDS=3.0
# FAKEYOU_IDENTITY__VOICEPRINT_RETENTION_DAYS=90
# FAKEYOU_IDENTITY__VOICEPRINT_POLICY_VERSION=v1
# FAKEYOU_IDENTITY__VOICEPRINT_TIMEOUT_SECONDS=5.0
FAKEYOU_PATHS__JOURNAL_DIR=.runtime/journals
FAKEYOU_PATHS__RECORD_DIR=.runtime/meetings
FAKEYOU_PATHS__BROWSER_PROFILE_DIR=.runtime/profiles
FAKEYOU_PATHS__BROWSER_OUTPUT_DIR=.runtime/browser
# Checkpoint percakapan disimpan di Postgres; wajib untuk CLI dan worker. Hapus tanda # lalu isi.
# Password di URL harus sama dengan POSTGRES_PASSWORD di bawah.
# FAKEYOU_DATABASE__URL=postgresql://fakeyou:ISI_POSTGRES_PASSWORD@localhost:5432/fakeyou
# FAKEYOU_DATABASE__CONNECT_TIMEOUT_SECONDS=5.0
# FAKEYOU_DATABASE__STATEMENT_TIMEOUT_SECONDS=30.0
# FAKEYOU_DATABASE__SEND_TIMEOUT_SECONDS=5.0
# FAKEYOU_DATABASE__KEEPALIVE_IDLE_SECONDS=30.0
# Runtime container memakai file env per-runtime: isi FAKEYOU_DATABASE__URL,
# FAKEYOU_MEMORY__STORE__URI, dan FAKEYOU_MEMORY__EMBEDDER__BASE_URL di sana
# dengan nama service (postgres, neo4j), bukan localhost. Tidak ada alias compose.
# Batas tiap service worker; naikkan satu per role tanpa menyentuh yang lain.
# Role sessions memegang Chromium dan audio, jadi paling besar.
# Endpoint dependency dari container worker pakai nama service Compose.
# FAKEYOU_COMPOSE_NEO4J_URI=bolt://neo4j:7687
# FAKEYOU_COMPOSE_EMBEDDINGS_BASE_URL=http://embeddings:80
# FAKEYOU_COMPOSE_WORKER_SESSIONS_MEM_LIMIT=4g
# FAKEYOU_COMPOSE_WORKER_SESSIONS_CPUS=2
# FAKEYOU_COMPOSE_WORKER_INGESTION_MEM_LIMIT=2g
# FAKEYOU_COMPOSE_WORKER_INGESTION_CPUS=2
# FAKEYOU_COMPOSE_WORKER_DEBRIEF_MEM_LIMIT=1g
# FAKEYOU_COMPOSE_WORKER_DEBRIEF_CPUS=1
# FAKEYOU_COMPOSE_WORKER_REEMBED_MEM_LIMIT=2g
# FAKEYOU_COMPOSE_WORKER_REEMBED_CPUS=1
FAKEYOU_SPEECH__LANGUAGE=id
FAKEYOU_REPLY__MODEL=gpt-4.1-mini
# FAKEYOU_REPLY__API_KEY=
FAKEYOU_REPLY__TIMEOUT_SECONDS=15.0
FAKEYOU_REPLY__MAX_RETRIES=2
FAKEYOU_REPLY__PROVIDER=openai
FAKEYOU_REPLY__BASE_URL=https://api.openai.com/v1
# Kosongkan untuk penalaran default provider. Nilai yang valid: minimal, low, medium, high.
# FAKEYOU_REPLY__REASONING_EFFORT=medium
# Hanya untuk provider openai_compatible.
# FAKEYOU_REPLY__EXTRA_BODY={}
# Debrief memakai peran reply bila FAKEYOU_DEBRIEF__* tidak diset.
# FAKEYOU_DEBRIEF__PROVIDER=google
# FAKEYOU_DEBRIEF__MODEL=gemini-3.8-flash
# FAKEYOU_DEBRIEF__API_KEY=
# Timeout 60 detik disarankan untuk record live; anggaran total mengikuti peran debrief.
# FAKEYOU_DEBRIEF__TIMEOUT_SECONDS=60
# FAKEYOU_DEBRIEF__BASE_URL=
# FAKEYOU_DEBRIEF__MAX_RETRIES=2
# FAKEYOU_DEBRIEF__REASONING_EFFORT=medium
# FAKEYOU_DEBRIEF__EXTRA_BODY={}
# Peran fallback dipakai saat peran reply gagal. Blok ini menambah anggaran waktu respons;
# jika diaktifkan, naikkan FAKEYOU_CONVERSATION__RESPONSE_TIMEOUT_SECONDS agar anggaran muat.
# FAKEYOU_REPLY_FALLBACK__PROVIDER=openai
# FAKEYOU_REPLY_FALLBACK__MODEL=gpt-4.1-mini
# FAKEYOU_REPLY_FALLBACK__API_KEY=
# FAKEYOU_REPLY_FALLBACK__TIMEOUT_SECONDS=15.0
# FAKEYOU_REPLY_FALLBACK__MAX_RETRIES=1
# FAKEYOU_REPLY_FALLBACK__BASE_URL=https://api.openai.com/v1
# FAKEYOU_REPLY_FALLBACK__REASONING_EFFORT=medium
# FAKEYOU_REPLY_FALLBACK__EXTRA_BODY={}
# FAKEYOU_REPLY_STRONG__PROVIDER=google
# FAKEYOU_REPLY_STRONG__MODEL=gemini-3.8-flash
# FAKEYOU_REPLY_STRONG__API_KEY=
# FAKEYOU_REPLY_STRONG__TIMEOUT_SECONDS=15.0
# FAKEYOU_REPLY_STRONG__MAX_RETRIES=1
# FAKEYOU_REPLY_STRONG__BASE_URL=https://generativelanguage.googleapis.com
# FAKEYOU_REPLY_STRONG__REASONING_EFFORT=low
# FAKEYOU_REPLY_STRONG__EXTRA_BODY={}
# FAKEYOU_TTS__API_KEY=
FAKEYOU_TTS__SAMPLE_RATE=24000
FAKEYOU_TTS__PROVIDER=openai
FAKEYOU_TTS__MODEL=gpt-4o-mini-tts
FAKEYOU_TTS__VOICE=alloy
FAKEYOU_TTS__BASE_URL=https://api.openai.com/v1
FAKEYOU_STT__PROVIDER=muse
FAKEYOU_STT__MODEL=muse-voice-transcribe-1.0
# FAKEYOU_STT__API_KEY=
FAKEYOU_STT__URL=wss://api.meta.ai/v1/asr/realtime
FAKEYOU_STT__MODE=DIARIZATION
FAKEYOU_STT__IDLE_RECONNECT_SECONDS=0.0
FAKEYOU_STT__READY_TIMEOUT_SECONDS=10.0
FAKEYOU_STT__DIARIZE_TIMEOUT_SECONDS=60.0
FAKEYOU_STT__DIARIZE_MAX_RETRIES=3
FAKEYOU_VAD__CONFIDENCE=0.7
FAKEYOU_VAD__START_SECS=0.2
FAKEYOU_VAD__STOP_SECS=0.2
FAKEYOU_VAD__MIN_VOLUME=0.6
FAKEYOU_MEMORY__STORE__URI=bolt://localhost:7687
FAKEYOU_MEMORY__STORE__USER=neo4j
# FAKEYOU_MEMORY__STORE__PASSWORD=
FAKEYOU_MEMORY__STORE__DATABASE=neo4j
FAKEYOU_MEMORY__LLM__MODEL=gpt-5.5
FAKEYOU_MEMORY__LLM__SMALL_MODEL=gpt-4.1-nano
# FAKEYOU_MEMORY__LLM__API_KEY=
FAKEYOU_MEMORY__LLM__CLIENT=openai
FAKEYOU_MEMORY__LLM__BASE_URL=https://api.openai.com/v1
FAKEYOU_MEMORY__LLM__TIMEOUT_SECONDS=60.0
FAKEYOU_MEMORY__LLM__MAX_RETRIES=2
FAKEYOU_MEMORY__EMBEDDER__MODEL=text-embedding-3-small
# FAKEYOU_MEMORY__EMBEDDER__API_KEY=
FAKEYOU_MEMORY__EMBEDDER__BASE_URL=https://api.openai.com/v1
FAKEYOU_MEMORY__EMBEDDER__DIM=1024
FAKEYOU_MEMORY__EMBEDDER__TIMEOUT_SECONDS=60.0
FAKEYOU_MEMORY__EMBEDDER__MAX_RETRIES=2
FAKEYOU_MEMORY__RECALL__RESULT_LIMIT=5
FAKEYOU_MEMORY__RECALL__TIMEOUT_SECONDS=15.0
FAKEYOU_MEMORY__RECALL__STRATEGY=prefetch
FAKEYOU_MEMORY__INGESTION__WINDOW_UTTERANCES=20
FAKEYOU_MEMORY__INGESTION__WINDOW_SECONDS=60.0
FAKEYOU_MEMORY__INGESTION__EPISODE_TIMEOUT_SECONDS=120.0
FAKEYOU_MEMORY__INGESTION__EXTRACTION_CONCURRENCY=20
FAKEYOU_MEMORY__CLOSE_CALLBACK_SECONDS=5.0
FAKEYOU_MEMORY__CLOSE_HARD_SECONDS=30.0
FAKEYOU_CONVERSATION__RESPONSE_TIMEOUT_SECONDS=60.0
FAKEYOU_CONVERSATION__BARGE_IN_MIN_WORDS=3
FAKEYOU_CONVERSATION__MAX_SPOKEN_SENTENCES=2
FAKEYOU_CONVERSATION__SENTENCE_STREAMING=true
FAKEYOU_CONVERSATION__THINKING_CUE_ENABLED=true
FAKEYOU_CONVERSATION__THINKING_CUE_AFTER_SECONDS=2.0
FAKEYOU_CONVERSATION__VOICE_LABELS_ENABLED=false
FAKEYOU_CONVERSATION__MEET_CHAT_PER_MINUTE=3
FAKEYOU_CONVERSATION__PER_STREAM_ENABLED=false
FAKEYOU_CONVERSATION__PARTICIPANT_EVIDENCE_MAX_BYTES=8388608
FAKEYOU_CONVERSATION__HISTORY_MAX_TOKENS=32000
FAKEYOU_TURN_JUDGE__TIMEOUT_SECONDS=4.0
FAKEYOU_TURN_JUDGE__WINDOW_LINES=8
FAKEYOU_TURN_JUDGE__REPLY_THRESHOLD=0.6
FAKEYOU_TURN_JUDGE__CLARIFY_THRESHOLD=0.5
# FAKEYOU_TURN_JUDGE__MODEL__PROVIDER=google
# FAKEYOU_TURN_JUDGE__MODEL__MODEL=gemini-3.1-flash-lite
# FAKEYOU_TURN_JUDGE__MODEL__API_KEY=
# FAKEYOU_TURN_JUDGE__MODEL__TIMEOUT_SECONDS=4.0
# FAKEYOU_TURN_JUDGE__MODEL__MAX_RETRIES=0
# FAKEYOU_TURN_JUDGE__MODEL__BASE_URL=https://generativelanguage.googleapis.com
# FAKEYOU_TURN_JUDGE__MODEL__REASONING_EFFORT=minimal
# FAKEYOU_TURN_JUDGE__MODEL__EXTRA_BODY={}
FAKEYOU_MEETING__LOBBY_TIMEOUT_SECONDS=300.0
FAKEYOU_MEETING__SESSION_DURATION_SECONDS=7200.0
FAKEYOU_MEETING__JOIN_POLL_SECONDS=2.0
FAKEYOU_MEETING__MONITOR_POLL_SECONDS=5.0
FAKEYOU_MEETING__LEAVE_TIMEOUT_SECONDS=30.0
FAKEYOU_MEETING__JOIN_MAX_ATTEMPTS=3
FAKEYOU_MEETING__JOIN_RETRY_BASE_SECONDS=2.0
FAKEYOU_MEETING__JOIN_RETRY_CAP_SECONDS=30.0
FAKEYOU_MEETING__ALONE_LEAVE_SECONDS=600.0
FAKEYOU_BROWSER__HEADLESS=false
FAKEYOU_BROWSER__WARMUP=true
# FAKEYOU_BROWSER__LICENSE_KEY=
FAKEYOU_AUDIO_HEALTH__DEAF_WINDOW_SECONDS=120.0
FAKEYOU_AUDIO_HEALTH__DEAF_GRACE_SECONDS=120.0
FAKEYOU_PREFLIGHT__BUDGET_SECONDS=5.0
FAKEYOU_AUDIO__PERSIST_ENABLED=false
FAKEYOU_AUDIO__RETENTION_DAYS=30
FAKEYOU_AUDIO__DRAIN_MAX_CONSECUTIVE_FAILURES=40
FAKEYOU_AUDIO__DRAIN_FAILURE_JOURNAL_EVERY=10
FAKEYOU_AUDIO__PACTL_TIMEOUT_SECONDS=5.0
# Perception (mata twin: screen share, chat, sinyal meeting, kamera) memakai kunci sendiri
# dan tidak meminjam FAKEYOU_REPLY__API_KEY.
# FAKEYOU_PERCEPTION__ENABLED=false
# FAKEYOU_PERCEPTION__SCREEN=true
# FAKEYOU_PERCEPTION__CHAT=true
# FAKEYOU_PERCEPTION__SIGNALS=true
# FAKEYOU_PERCEPTION__CAMERAS=true
# FAKEYOU_PERCEPTION__INTERPRETER__PROVIDER=google
# FAKEYOU_PERCEPTION__INTERPRETER__MODEL=gemini-3.8-flash
# FAKEYOU_PERCEPTION__INTERPRETER__API_KEY=
# FAKEYOU_PERCEPTION__INTERPRETER__BASE_URL=
# FAKEYOU_PERCEPTION__INTERPRETER__TIMEOUT_SECONDS=30.0
# FAKEYOU_PERCEPTION__INTERPRETER__MAX_RETRIES=2
# FAKEYOU_PERCEPTION__INTERPRETER__MAX_CONCURRENT=2
# FAKEYOU_PERCEPTION__BUDGET_USD=1.0
# FAKEYOU_PERCEPTION__MAX_CALLS=240
# FAKEYOU_PERCEPTION__VIEW_MAX_CHARS=6000
# FAKEYOU_PERCEPTION__RETENTION_RAW_DAYS=7
# FAKEYOU_PERCEPTION__RETENTION_TEXT_DAYS=30
# FAKEYOU_PERCEPTION__ATTENTION__ENABLED=true
# FAKEYOU_PERCEPTION__ATTENTION__MAX_INTERJECTIONS_PER_10MIN=2
# FAKEYOU_PERCEPTION__ATTENTION__FLOOR_GAP_SECONDS=1.2
# FAKEYOU_PERCEPTION__ATTENTION__TTL_SECONDS=30.0
FAKEYOU_API__HOST=127.0.0.1
FAKEYOU_API__PORT=8000
# FAKEYOU_API__ADMIN_TOKEN=
# FAKEYOU_API__OWNER_TOKEN=
FAKEYOU_API__RATE_LIMIT_PER_MINUTE=120
# FAKEYOU_TRANSPORT__REDIS__URL=redis://localhost:6379/0
FAKEYOU_TRANSPORT__REDIS__STREAM_MAX_LEN=10000
FAKEYOU_TRANSPORT__REDIS__LEASE_SECONDS=30.0
FAKEYOU_TRANSPORT__REDIS__CONNECT_TIMEOUT_SECONDS=5.0
FAKEYOU_WORKER__AUDIO=false
# FAKEYOU_COMPOSE_EMBEDDINGS_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9
# FAKEYOU_COMPOSE_EMBEDDINGS_MODEL_ID=ibm-granite/granite-embedding-97m-multilingual-r2
# FAKEYOU_COMPOSE_EMBEDDINGS_REVISION=835ad14087e140460703cf0fae09f97d469d65c2
PULSE_SOURCE=meeting_audio.monitor
PULSE_SINK=agent_output
# EVAL_JUDGE_API_KEY=
# Wajib diisi: compose menolak menyalakan postgres tanpa nilai ini. Volume yang sudah terisi tidak berubah.
POSTGRES_PASSWORD=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
DEEPEVAL_TELEMETRY_OPT_OUT=YES
GRAPHITI_TELEMETRY_ENABLED=false

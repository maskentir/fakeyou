FAKEYOU_OPENAI_API_KEY=
FAKEYOU_MODEL_API_KEY=
FAKEYOU_CLOAKBROWSER_LICENSE_KEY=
FAKEYOU_CHAT_MODEL=openai:gpt-4.1-mini
# FAKEYOU_CHAT_BASE_URL=https://api.meta.ai/v1
# FAKEYOU_CHAT_API_KEY=
# FAKEYOU_CHAT_REASONING_EFFORT=minimal

FAKEYOU_MEMORY_LLM_MODEL=gpt-5.5
FAKEYOU_MEMORY_SMALL_MODEL=gpt-4.1-nano
FAKEYOU_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
FAKEYOU_STT_MODEL=muse-voice-transcribe-1.0
FAKEYOU_CHECKPOINT_PATH=.runtime/checkpoints.sqlite
FAKEYOU_HEADLESS=false
FAKEYOU_MEMORY_GROUP=local_twin
FAKEYOU_OWNER_ID=local_owner
FAKEYOU_TWIN_ID=local_twin
